{
  "name": "auto-router-admin-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "fonts:generate": "node scripts/generate-fonts.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "predev": "npm run fonts:generate && npm run icons:generate",
    "dev": "vite",
    "pretypecheck": "npm run fonts:generate && npm run icons:generate",
    "typecheck": "vue-tsc --noEmit",
    "api:types": "openapi-typescript ../docs/openapi.yaml -o src/lib/generated-api.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild": "npm run fonts:generate && npm run icons:generate",
    "build": "vite build",
    "check:embedded-assets": "node scripts/check-embedded-assets.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.136",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
